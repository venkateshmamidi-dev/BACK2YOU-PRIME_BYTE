# Back2You Environment Configuration

# Server & Deployment
PORT=8000
SECRET_KEY=your_secure_secret_key_here

# CORS / Allowed Origins (comma-separated origins for production frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000
FRONTEND_URL=

# Supabase Credentials (Optional: Leave empty to run with local SQLite & Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# Matching Engine Factor Weights (Must sum to ~1.0)
WEIGHT_IMAGE=0.40
WEIGHT_TEXT=0.30
WEIGHT_LOCATION=0.15
WEIGHT_TIME=0.10
WEIGHT_ATTRIBUTES=0.05
